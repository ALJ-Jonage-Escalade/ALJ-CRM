{
  "name": "alj-crm-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "ALJ Escalade web app (Vue 3). Version: ../VERSION, injected at build time.",
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:api": "openapi-typescript openapi.json -o src/lib/api-schema.ts --default-non-nullable false",
    "check:api": "openapi-typescript openapi.json -o src/lib/api-schema.ts --default-non-nullable false --check"
  },
  "dependencies": {
    "@firebase/app": "0.16.7",
    "@firebase/auth": "1.13.11",
    "@tanstack/vue-table": "9.3.1",
    "chart.js": "4.6.1",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "openapi-fetch": "0.17.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.2",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.2",
    "vue-tsc": "3.3.14"
  },
  "allowScripts": {
    "@firebase/util": false
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
