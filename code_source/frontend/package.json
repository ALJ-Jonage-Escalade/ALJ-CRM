{
  "name": "alj-crm-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "ALJ Escalade web app (Vue 3). Version: ../VERSION, injected at build time.",
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "gen:api": "openapi-typescript openapi.json -o src/lib/api-schema.ts --default-non-nullable false",
    "check:api": "openapi-typescript openapi.json -o src/lib/api-schema.ts --default-non-nullable false --check"
  },
  "dependencies": {
    "@firebase/app": "0.16.4",
    "@firebase/auth": "1.13.8",
    "@tanstack/vue-table": "9.3.1",
    "openapi-fetch": "0.17.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "allowScripts": {
    "@firebase/util": false
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
